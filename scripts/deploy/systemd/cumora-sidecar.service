# Cumora yjs-sidecar(文档协同)。
# #280:sidecar 退出 TS 工作树形态 —— bun build --compile 产出的自包含
# 单二进制随 go-release.yml 制品分发,与 server/daemon 同一 current
# symlink 寻址(#211 链);node/nvm/tsx 运行依赖就此退役。CRDT 引擎仍
# 是 TS 实现(yjs),只是打包形态变了 —— 见 ADR 0005 路线 A 修订。
[Unit]
Description=Cumora yjs-sidecar (doc collab)
# 无 go 依赖:sidecar 是独立 HTTP 服务(:5182),server(docrelay)才是
# 它的客户端 —— 排序是 cumora-go After= 本单元,而非相反;pg/redis 为
# 系统级服务,用户管理器无法排序,缺连接时进程自身崩溃循环交
# Restart=always 收敛。
After=network-online.target

[Service]
# cwd=仓库根:.env 仍经 dotenv 从 cwd 解析(凭据不动窝,#284 首启向导
# 再迁);本地 FS 存储根与 cumora-go.service 注入同值(%h 由 systemd
# 展开为用户家目录),文档快照/内联图片附件直落仓外数据目录。
WorkingDirectory=%h/Code/cumora
EnvironmentFile=%h/Code/cumora/.env
Environment=CUMORA_UPLOADS_DIR=%h/.local/share/cumora/uploads
Environment=YJS_SIDECAR_PORT=5182
# 切换日前由 runbook 生成并写入 .env(YJS_SIDECAR_TOKEN),两栈同源读取
ExecStart=%h/.local/share/cumora/current/cumora-sidecar
Restart=always
RestartSec=3
# ExecStartPost 探针(#211):最坏 30×(2s curl+1s sleep)≈90s 内 /internal/healthz
# 就绪 —— 200 与 401 都算(该面需 Bearer token,401 即"进程活着且鉴权
# 面在岗");始终无应答(启动崩溃)才判失败交 Restart 自愈。此探针同
# 时是三件套 enable 链的第一道门:cumora-go After= 本单元,healthz 探针
# 通过后 go 才启动。
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do curl -s --max-time 2 http://127.0.0.1:5182/internal/healthz >/dev/null 2>&1 && exit 0; sleep 1; done; echo yjs-sidecar did not answer /internal/healthz within 90s >&2; exit 1'
TimeoutStartSec=110

[Install]
WantedBy=default.target
